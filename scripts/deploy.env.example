# Template for the kilokaki-site deploy config.
#
# This repo is PUBLIC. Never fill this file in and commit it. Copy it outside
# the tree and fill in the real values there:
#
#   mkdir -p ~/.config/kilokaki-site
#   cp scripts/deploy.env.example ~/.config/kilokaki-site/deploy.env
#   chmod 600 ~/.config/kilokaki-site/deploy.env
#
# Override the location with KILOKAKI_DEPLOY_ENV if you keep it elsewhere.
# Values come from: Cloudways dashboard -> App -> Access Details, plus the
# Cloudflare and Cloudways API token pages.

# --- Credentials ---
SSHPASS=""        # Cloudways SFTP/SSH password
CF_ZONE_ID=""     # Cloudflare zone id for kilokaki.com
CF_API_TOKEN=""   # Cloudflare token with Zone.Cache Purge
CW_SERVER_ID=""   # Cloudways server id
CW_APP_ID=""      # Cloudways app id
CW_API_TOKEN=""   # Cloudways API token (NOT the api_key — see below)

# --- Cloudways api/v1 OAuth ---
# api/v1 has no static-bearer path. scripts/cache-purge.sh mints a short-lived
# bearer by POSTing these two to /api/v1/oauth/access_token.
# CW_API_TOKEN above is a DIFFERENT credential and returns 403
# invalid_credentials against that endpoint — measured 2026-07-22, same email,
# one operand varied. Do not substitute one for the other.
CW_EMAIL=""       # Cloudways account email
CW_API_KEY=""     # Cloudways -> Account -> API Key

# --- Infra topology (also kept out of this public repo) ---
REMOTE_USER=""      # Cloudways SFTP/SSH username
REMOTE_HOST=""      # Cloudways server IP
REMOTE_BASE_DIR=""  # App base dir; public_html is appended by the script
